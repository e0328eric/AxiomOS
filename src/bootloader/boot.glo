// Assembly-only translation unit. No imports or standard-library operations.
// Compile separately with --no-std --no-main --backend object and
// --target x86_64-freestanding. first.glo selects these options for boot.o.
// This exported, non-inlined carrier is never called. The assembler-defined
// _start is in its own section, so GRUB never enters a compiler prologue.
boot_assembly :: () #c_call #inline,never {
    #asm {
        \\.pushsection .multiboot_header,"a",@progbits
        \\.balign 8
        \\.Lheader_start:
        \\.long 0xE85250D6, 0
        \\.long .Lheader_end - .Lheader_start
        \\.long -(0xE85250D6 + .Lheader_end - .Lheader_start)
        \\.short 0, 0
        \\.long 8
        \\.Lheader_end:
        \\.popsection
        \\.pushsection .bss.boot,"aw",@nobits
        \\.balign 4096
        \\.Lp4_table: .skip 4096
        \\.Lp3_table: .skip 4096
        \\.Lp2_table: .skip 4096
        \\.Lstack_bottom: .skip 65536
        \\.Lstack_top:
        \\.popsection
        \\.pushsection .text.boot,"ax",@progbits
        \\.balign 16
        \\.globl _start
        \\.type _start,@function
        \\.code32
        \\_start:
        \\cli
        \\cld
        \\movl $.Lstack_top, %esp
        \\cmpl $0x36D76289, %eax
        \\jne .Lbad_multiboot
        \\pushfl
        \\popl %eax
        \\movl %eax, %ecx
        \\xorl $(1 << 21), %eax
        \\pushl %eax
        \\popfl
        \\pushfl
        \\popl %eax
        \\pushl %ecx
        \\popfl
        \\cmpl %ecx, %eax
        \\je .Lbad_cpuid
        \\movl $0x80000000, %eax
        \\cpuid
        \\cmpl $0x80000001, %eax
        \\jb .Lbad_long_mode
        \\movl $0x80000001, %eax
        \\cpuid
        \\testl $(1 << 29), %edx
        \\jz .Lbad_long_mode
        \\movl $.Lp4_table, %edi
        \\xorl %eax, %eax
        \\movl $(3 * 4096 / 4), %ecx
        \\rep stosl
        \\movl $.Lp3_table, %eax
        \\orl $3, %eax
        \\movl %eax, .Lp4_table
        \\movl $.Lp2_table, %eax
        \\orl $3, %eax
        \\movl %eax, .Lp3_table
        \\xorl %ecx, %ecx
        \\.Lmap_page:
        \\movl %ecx, %eax
        \\shll $21, %eax
        \\orl $0x83, %eax
        \\movl %eax, .Lp2_table(,%ecx,8)
        \\incl %ecx
        \\cmpl $512, %ecx
        \\jne .Lmap_page
        \\movl $.Lp4_table, %eax
        \\movl %eax, %cr3
        \\movl %cr4, %eax
        \\orl $((1 << 5) | (1 << 9) | (1 << 10)), %eax
        \\movl %eax, %cr4
        \\movl $0xC0000080, %ecx
        \\rdmsr
        \\orl $(1 << 8), %eax
        \\wrmsr
        \\movl %cr0, %eax
        \\andl $~((1 << 2) | (1 << 3)), %eax
        \\orl $((1 << 31) | (1 << 1)), %eax
        \\movl %eax, %cr0
        \\lgdt .Lgdt64_pointer
        \\ljmpl $0x08, $.Llong_mode_start
        \\.Lbad_multiboot:
        \\movb $'0', %al
        \\jmp .Lboot_error
        \\.Lbad_cpuid:
        \\movb $'1', %al
        \\jmp .Lboot_error
        \\.Lbad_long_mode:
        \\movb $'2', %al
        \\.Lboot_error:
        \\movl $0x4F524F45, 0xB8000
        \\movl $0x4F3A4F52, 0xB8004
        \\movw $0x4F20, 0xB8008
        \\movb %al, 0xB800A
        \\movb $0x4F, 0xB800B
        \\outb %al, $0xE9
        \\.Lerror_halt:
        \\hlt
        \\jmp .Lerror_halt
        \\.code64
        \\.Llong_mode_start:
        \\movw $0x10, %ax
        \\movw %ax, %ss
        \\movw %ax, %ds
        \\movw %ax, %es
        \\xorl %eax, %eax
        \\movw %ax, %fs
        \\movw %ax, %gs
        \\movq $.Lstack_top, %rsp
        \\xorl %ebp, %ebp
        \\fninit
        \\call glo_kmain
        \\.Lkernel_halt:
        \\cli
        \\hlt
        \\jmp .Lkernel_halt
        \\.size _start, .-_start
        \\.popsection
        \\.pushsection .rodata.boot,"a",@progbits
        \\.balign 8
        \\.Lgdt64:
        \\.quad 0
        \\.quad 0x00AF9A000000FFFF
        \\.quad 0x00CF92000000FFFF
        \\.Lgdt64_end:
        \\.Lgdt64_pointer:
        \\.short .Lgdt64_end - .Lgdt64 - 1
        \\.long .Lgdt64
        \\.popsection
    }
}
