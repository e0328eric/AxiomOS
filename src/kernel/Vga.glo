#import "Io/Core";
#import "Io/Format";
#import "Meta";
Port :: #import "port.glo";

#public {
    VGA_BUFFER_WIDTH :: 80;
    VGA_BUFFER_HEIGHT :: 25;
    VGA_BUFFER_ADDR :: 16#B8000;

    VgaColorCode :: enum u4 {
        Black :: 0;
        Blue;
        Green;
        Cyan;
        Red;
        Magenta;
        Brown;
        LightGrey;
        DarkGrey;
        LightBlue;
        LightGreen;
        LightCyan;
        LightRed;
        LightMagenta;
        LightBrown;
        White;
    }

    // Like Zig, the first u4 occupies the low nibble, the second the high.
    VgaColor :: struct #packed {
        fg: VgaColorCode;
        bg: VgaColorCode;
    }

    VgaChar :: struct #c_call {
        char: u8;
        color: VgaColor;
    }

    Vga :: struct {
        cursor_x: u16;
        cursor_y: u16;
        color: VgaColor;
        buffer: [*]volatile VgaChar;
    }

    // The standard Writer typeclass takes the place of Zig's GenericWriter.
    // This adapter keeps the same borrowed context as the Zig writer.
    VgaWriter :: struct {
        state: *Vga;
    }
}

VgaColor ::: #public {
    init :: (fg: VgaColorCode, bg: VgaColorCode) -> VgaColor {
        return .{ .fg = fg, .bg = bg };
    }

}

#comptime {
    #assert size_of(VgaColor) == 1;
    #assert size_of(VgaChar) == 2;
    #assert type_info(VgaChar).alignment == 1;
}

Vga ::: #public {
    init :: (fg: VgaColorCode, bg: VgaColorCode) -> Vga {
        return .{
            .cursor_x = 0,
            .cursor_y = 0,
            .color = VgaColor.init(fg, bg),
            .buffer = cast([*]volatile VgaChar) VGA_BUFFER_ADDR,
        };
    }

    moveCursor :: (*#self) {
        cursor_location := #self.cursor_y * VGA_BUFFER_WIDTH + #self.cursor_x;
        Port.outb(16#3D4, 14);
        Port.outb(16#3D5, cast(u8)((cursor_location >> 8) & 255));
        Port.outb(16#3D4, 15);
        Port.outb(16#3D5, cast(u8)(cursor_location & 255));
    }

    scroll :: (*#self) {
        blank := VgaChar.{ .char = #char " ", .color = VgaColor.init(.White, .Black) };
        if #self.cursor_y >= VGA_BUFFER_HEIGHT {
            i: ssize = 0;
            while i < (VGA_BUFFER_HEIGHT - 1) * VGA_BUFFER_WIDTH {
                #self.buffer[i] = #self.buffer[i + VGA_BUFFER_WIDTH];
                i += 1;
            }
            while i < VGA_BUFFER_HEIGHT * VGA_BUFFER_WIDTH {
                #self.buffer[i] = blank;
                i += 1;
            }
            #self.cursor_y = VGA_BUFFER_HEIGHT - 1;
        }
    }

    writer :: (*#self) -> VgaWriter {
        return .{ .state = #self };
    }

    writeChar :: (*#self, chr: u8) {
        // Mirror output to QEMU debugcon for the boot test.
        Port.outb(16#E9, chr);
        if chr == 8 && #self.cursor_x > 0 {
            #self.cursor_x -= 1;
        } else if chr == 9 {
            #self.cursor_x = (#self.cursor_x + 4) & ~cast(u16) 3;
        } else if chr == #char "\r" {
            #self.cursor_x = 0;
        } else if chr == #char "\n" {
            #self.cursor_x = 0;
            #self.cursor_y += 1;
        } else if chr >= #char " " {
            #self.buffer[#self.cursor_y * VGA_BUFFER_WIDTH + #self.cursor_x] = .{
                .char = chr,
                .color = #self.color,
            };
            #self.cursor_x += 1;
        }
        if #self.cursor_x >= VGA_BUFFER_WIDTH {
            #self.cursor_x = 0;
            #self.cursor_y += 1;
        }
        #self.scroll();
        #self.moveCursor();
    }

    write :: (*#self, text: []const u8) -> Io_Error!ssize {
        write_len: ssize = 0;
        for chr: text {
            #self.writeChar(chr);
            write_len += 1;
        }
        return .Ok(write_len);
    }

    clearMonitor :: (*#self) {
        blank := VgaChar.{ .char = #char " ", .color = VgaColor.init(.White, .Black) };
        i: ssize = 0;
        while i < VGA_BUFFER_WIDTH * VGA_BUFFER_HEIGHT {
            #self.buffer[i] = blank;
            i += 1;
        }
        #self.cursor_x = 0;
        #self.cursor_y = 0;
        #self.moveCursor();
    }
}

VgaWriter ::: instance Writer {
    write :: (self: *VgaWriter, text: []const u8) -> Io_Error!ssize {
        return self.state.write(text);
    }
}

VgaWriter ::: #public {
    print :: (*#self, #comptime format: str, args: ... any) -> Io_Error!void {
        #self.write_format(format, args ...)?;
        return .Ok;
    }
}
