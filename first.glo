// glosso first.glo -- <command>; the boot object is assembled with fasm.
#import "Compiler";
#import "Format";
#import "Io";
#import "Os";

fail :: (message: str) -> #Never {
    print("[AxiomOS] {}\n", message);
    exit(1);
}

checked :: (result: Compiler_Error!str) {
    if result == {
        case .Ok(output);
            print("{}", output);
            output.free();
        case .Err(error);
            fail(error.message);
    }
}

kernel_name :: (boot_test: bool) -> str {
    if boot_test return "test-kernel.bin";
    return "kernel.bin";
}

iso_path :: (boot_test: bool = false) -> str {
    if boot_test return "build/test.iso";
    return "AxiomOS.iso";
}

build_boot :: () {
    checked(run_build_command("mkdir -p build"));
    checked(run_build_command("\"${FASM:-fasm}\" src/bootloader/boot.asm build/boot.o"));
}

build_kernel :: (boot_test: bool = false) {
    build_boot();
    workspace := Workspace.create("AxiomOS");
    options := workspace.get_build_options();
    options.target.os = .Freestanding;
    options.target.cpu = .X86_64;
    options.backend = .LLVM;
    options.output_path = "build";
    options.output_executable_name = kernel_name(boot_test);
    if boot_test {
        options.compile_time_command_line.push("boot-test");
    }
    options.optimization_level = .Optimized;
    options.temp_allocator_size = 64 * 1024;
    options.set_no_main();
    options.set_linker_script("linker.ld");
    options.add_compiler_arg("--cache-dir=build/cache");
    options.add_linker_args(
        "build/boot.o",
        "-z",
        "max-page-size=4096",
        "--build-id=none"
    );
    options.set_build_options(workspace);
    checked(add_build_file("src/kernel/kmain.glo", workspace));
    print("[AxiomOS] built build/{} using Glosso's ELF linker\n", options.output_executable_name);
}

make_iso :: (boot_test: bool = false) {
    build_kernel(boot_test);
    stage := "isodir";
    if boot_test stage = "build/test-isodir";
    image := iso_path(boot_test);
    checked(run_build_command(tprint("mkdir -p {}/boot/grub", stage)));
    checked(
        run_build_command(
            tprint("cp build/{} {}/boot/kernel.bin", kernel_name(boot_test), stage)
        )
    );
    checked(run_build_command(tprint("cp src/bootloader/grub.cfg {}/boot/grub/grub.cfg", stage)));
    checked(
        run_build_command(tprint("\"${{GRUB_MKRESCUE:-grub-mkrescue}}\" -o {} {}", image, stage))
    );
    print("[AxiomOS] built {}\n", image);
}

run_build :: () {
    set_build_options_dc(.do_output = false);
    #if HOST.os != .Linux
    #compile_error "The AxiomOS build uses Linux host tools (fasm, GRUB and QEMU)";

    args := get_cmdline_args();
    if args.count > 1 fail("expected <command>; use -- help");
    command := "build";
    if args.count >= 1 command = args[0];
    if command == "help" {
        print("glosso first.glo -- [build|make-iso|make-test-iso|run-qemu|test|clean]\n");
        return;
    }
    // Guard the fixed relative paths, especially the clean command.
    checked(run_build_command("test -f src/kernel/kmain.glo && test -f src/bootloader/boot.asm"));
    if command == {
        case "build";
            build_kernel();
        case "make-iso";
            make_iso();
        case "make-test-iso";
            make_iso(true);
        case "test";
            make_iso(true);
            checked(run_build_command("\"${PYTHON:-python3}\" tests/gui_smoke.py"));
        case "run-qemu";
            make_iso();
            checked(
                run_build_command(
                    tprint(
                        "\"${{QEMU:-qemu-system-x86_64}}\" -m 128M -cdrom {} -boot d -vga std -debugcon file:build/debug.log",
                        iso_path()
                    )
                )
            );
        case "clean";
            checked(run_build_command("rm -rf -- build isodir AxiomOS.iso"));
        else;
            fail("unknown subcommand; use -- help");
    }
}

#comptime run_build();
main :: () {}
